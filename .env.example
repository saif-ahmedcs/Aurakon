# =============================================================================
# Docker Compose environment variables (LOCAL DEVELOPMENT ONLY)
# Copy this file to .env and fill in all values before running docker compose up
# =============================================================================

# MySQL root password (used internally by the local MySQL container)
MYSQL_ROOT_PASSWORD=

# Database credentials (shared between the local MySQL container and Backend)
DB_USER=
DB_PASSWORD=
DB_NAME=aurakon

# Backend application environment
NODE_ENV=development

# Database pool connection limit
DB_CONNECTION_LIMIT=10

# Secret key for JWT signing and verification (MUST be at least 32 characters long)
JWT_SECRET=

# Number of days before unverified accounts are automatically pruned by cleanup runner
CLEANUP_UNVERIFIED_DAYS=7

# Gmail SMTP credentials for sending transactional auth emails
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public Frontend Base URL for local development.
# Links generated in auth emails (verification, reset, confirmation) will
# target this base URL. Do not set a production/Vercel URL here — this file
# is for local docker compose only.
APP_BASE_URL=http://localhost:3001
