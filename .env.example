# =============================================================================
# Docker Compose environment variables
# Copy this file to .env and fill in all values before running docker compose up
# =============================================================================

# MySQL root password (used internally by the MySQL container)
MYSQL_ROOT_PASSWORD=

# Database credentials (shared between MySQL container and Backend)
DB_USER=
DB_PASSWORD=
DB_NAME=aurakon

# Backend application environment
# - "production": Enforces secure cookies (Secure: true) and production hardening.
#                 Requires TLS / HTTPS for public client traffic.
# - "development" / "test": Allows insecure cookies over HTTP for local testing.
NODE_ENV=production

# Database pool connection limit
DB_CONNECTION_LIMIT=10

# Secret key for JWT signing and verification (MUST be at least 32 characters long)
JWT_SECRET=

# Number of days before unverified accounts are automatically pruned by cleanup runner
CLEANUP_UNVERIFIED_DAYS=7

# Gmail SMTP credentials for sending transactional auth emails
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public Frontend Base URL
# - Local development / Docker test: http://localhost:3001 (or http://127.0.0.1:3001)
# - Production deployment: MUST be a valid HTTPS URL (e.g. https://aurakon.example.com)
# Links generated in auth emails (verification, reset, confirmation) will target this base URL.
APP_BASE_URL=http://localhost:3001

