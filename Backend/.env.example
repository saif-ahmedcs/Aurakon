# Database connection settings
#
# Local development (docker-compose mysql service): use the values below.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=aurakon
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# --- TiDB Cloud (future Render deployment) -----------------------------
# Not used for local development. When deploying the backend to Render
# against a TiDB Cloud database, override the values above with:
#   DB_HOST=<your-cluster>.<region>.prod.aws.tidbcloud.com   (from the
#            TiDB Cloud console "Connect" dialog for your cluster)
#   DB_PORT=4000
#   DB_USER=<TiDB user, e.g. <prefix>.root for Serverless>
#   DB_PASSWORD=<TiDB password>
# and enable TLS, which TiDB Cloud requires on its public endpoint for both
# Serverless and Dedicated clusters:
#   DB_SSL=true
# DB_SSL_CA_PATH is optional. TiDB Serverless uses a publicly-trusted
# certificate, so Node's built-in CA store works with no CA file needed.
# For TiDB Cloud Dedicated, you may instead download the CA bundle from the
# "Connect" dialog and pin it explicitly:
#   DB_SSL_CA_PATH=/path/to/ca.pem
DB_SSL=false
DB_SSL_CA_PATH=

# Application environment ("production", "development", or "test")
# In "production", cookies are issued with the Secure flag (requires HTTPS).
NODE_ENV=development

# JWT signing secret (MUST be at least 32 characters long)
JWT_SECRET=

# Number of days before unverified accounts are automatically pruned by cleanup runner
CLEANUP_UNVERIFIED_DAYS=7

# Gmail SMTP credentials for sending transactional auth emails
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public Frontend Base URL
# - Local development: http://localhost:3001 (or http://127.0.0.1:3001)
# - Production deployment: MUST be a valid HTTPS URL (e.g. https://aurakon.example.com)
APP_BASE_URL=http://localhost:3001