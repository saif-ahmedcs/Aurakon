# Database connection settings
#
# Local development (docker-compose mysql service): use the values below.
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=aurakon
DB_PORT=3306
DB_CONNECTION_LIMIT=10

# --- TiDB Cloud -----------------------------
DB_SSL=false
DB_SSL_CA_PATH=

# Application environment ("production", "development", or "test")
# In "production", cookies are issued with the Secure flag (requires HTTPS).
NODE_ENV=development

# JWT signing secret (MUST be at least 32 characters long)
JWT_SECRET=

# Number of days before unverified accounts are automatically pruned by cleanup runner
CLEANUP_UNVERIFIED_DAYS=7

# Shared secret used to authenticate Vercel Cron invocations of
# api/cron/cleanup.js. Generate a random 32+ char string (e.g. `openssl rand
# -hex 32`) and set it as an Environment Variable in the Vercel project
# settings — Vercel automatically sends it back as `Authorization: Bearer
# <value>` on every scheduled invocation. Not needed for the docker-compose
# deployment (server.js runs cleanup on its own, without this check).
CRON_SECRET=

# Gmail SMTP credentials for sending transactional auth emails
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Public Frontend Base URL
# - Local development: http://localhost:3001 (or http://127.0.0.1:3001)
# - Production deployment: MUST be a valid HTTPS URL (e.g. https://aurakon.example.com)
APP_BASE_URL=http://localhost:3001