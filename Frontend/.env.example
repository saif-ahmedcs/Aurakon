# Backend URL that the Next.js proxy (src/proxy.js) rewrites /api/* requests to.
#
# Local development (docker-compose): the backend service is reachable by
# its container name on the compose network.
BACKEND_INTERNAL_URL=http://backend:3000

# --- Future Vercel deployment (do not set yet) --------------------------
# Once the backend is deployed on Render, set this in the Vercel project's
# environment variables (not in this file, and not hardcoded in code) to
# the backend's Render URL, e.g.:
#   BACKEND_INTERNAL_URL=https://<your-backend>.onrender.com
